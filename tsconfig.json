{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "node",
        "lib": ["ES2022"],
        "strict": true,
        "outDir": "./target",
        "forceConsistentCasingInFileNames": true,
        "downlevelIteration": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "pretty": true,
        "sourceMap": true,
        "declaration": true,
        "removeComments": true,
        "incremental": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
    },
    "include": [ "src/*.ts" ]
}
